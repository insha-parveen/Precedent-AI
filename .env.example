# Precedent Environment Variables
# Copy to .env and fill in your values

# Secrets - Required for production
ANTHROPIC_API_KEY=your_anthropic_key_here
VOYAGE_API_KEY=your_voyage_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
GROK_API_KEY=your_grok_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta

# Authentication - JWT settings
JWT_SECRET_KEY=your_jwt_secret_key_here  # Secret key for JWT signing/validation
JWT_ALGORITHM=HS256                      # Algorithm for JWT (e.g., HS256, RS256)
JWT_ISSUER=your_issuer_here              # Expected issuer in tokens (e.g., your Keycloak realm)
JWT_AUDIENCE=your_audience_here          # Expected audience in tokens
JWT_RESOURCE_IDENTIFIER=precedent        # Resource identifier for role extraction (Keycloak format)
DEFAULT_ROLE=public                      # Default role if no roles found in token
# Role to access groups mapping (JSON format)
# Example: {"legal_team": ["public", "internal"], "audit": ["public"]}
ROLE_TO_ACCESS_GROUPS={"legal_team": ["public", "internal"], "audit": ["public"]}
ALWAYS_INCLUDE_PUBLIC=true               # Always include 'public' access group for demo compatibility

# Database - Use Supabase transaction pooler for serverless (Vercel)
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres

# Models
AGENT_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_DIM=1024

# App
PRECEDENT_ENV=production
LOG_LEVEL=INFO

# Frontend (set in Vercel dashboard)
# NEXT_PUBLIC_API_BASE=/api
# BACKEND_URL=https://your-project.vercel.app
