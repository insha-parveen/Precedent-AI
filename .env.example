# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
VOYAGE_API_KEY=pa-your-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
GROK_API_KEY=your-grok-key-here

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://precedent:precedent@localhost:5433/precedent

# --- Models ---
# Orchestrator/agent model. Sonnet 5 is the right default: cheap enough to run every
# query through a multi-step tool loop, capable enough to route skills and hold a
# citation-or-refuse instruction under pressure.
AGENT_MODEL=claude-sonnet-5
# Cheap classification model for the ingestion-time clause tagging pass.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Legal-domain embedding model. Swap to voyage-4 if you want a general-purpose model
# instead — see CLAUDE.md for the tradeoff.
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_DIM=1024

# --- App ---
PRECEDENT_ENV=dev
LOG_LEVEL=INFO
